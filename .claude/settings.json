{
  "model": "claude-opus-5-5",
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python3 tools/*)",
      "Bash(py -3 tools/*)",
      "Bash(ffprobe *)",
      "PowerShell(python tools/*)",
      "PowerShell(py -3 tools/*)",
      "PowerShell(ffprobe *)"
    ]
  }
}
